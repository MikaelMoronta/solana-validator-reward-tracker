# Copy this file to .env and fill in your own values. .env is git-ignored (never committed).
# The pg library reads these PG* settings automatically.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your-postgres-password
PGDATABASE=solana_tracker

# Solana JSON-RPC endpoint (optional; this public one is the default).
# The public endpoint allows about one getBlock every 2 seconds, so block fees take hours.
# A provider URL with an API key (e.g. Helius: https://mainnet.helius-rpc.com/?api-key=YOUR_KEY) should be much faster (not tested).
RPC_URL=https://api.mainnet-beta.solana.com

# Minimum milliseconds between requests (optional, default 2000 for the public endpoint).
# With a provider, set it to whatever its rate limit allows.
RPC_GAP_MS=2000
